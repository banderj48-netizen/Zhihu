# 知乎开放平台配置
# 服务器部署配置（HTTP 直连，暂不使用 Nginx）。
# 修改后重启服务生效。

# ---- OAuth 应用凭证（赛事页面分配）----
ZHIHU_OAUTH_APP_ID=468
ZHIHU_OAUTH_APP_KEY=1edca288684b4838a8beb643b7b74a12
ZHIHU_OAUTH_REDIRECT_URI=http://8.133.211.26:8000/api/v1/sources/zhihu/callback

# ---- 开放平台 Access Secret ----
# 已内置在 app/config.py 的 DEFAULTS 中，此处无需重复配置。
# 如需覆盖，取消下行注释并填入新值：
# ZHIHU_ACCESS_SECRET=

# ---- 会话与 Cookie ----
# 本地 http 环境下浏览器会忽略 Secure，故为 false；
# 部署到 https 后必须改为 true。
TWINLOOP_COOKIE_SECURE=false

# ---- 前端跨域 ----
TWINLOOP_CORS_ORIGINS=http://8.133.211.26:3000

# 授权完成后浏览器跳回的前端地址
TWINLOOP_FRONTEND_URL=http://8.133.211.26:3000/
