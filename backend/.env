# 知乎开放平台配置
# 服务器部署配置（HTTP 直连，暂不使用 Nginx）。
# 修改后重启服务生效。

# ---- OAuth 应用凭证（赛事页面分配）----
ZHIHU_OAUTH_APP_ID=468
ZHIHU_OAUTH_APP_KEY=1edca288684b4838a8beb643b7b74a12
ZHIHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/sources/zhihu/callback

# ---- 开放平台 Access Secret ----
# 已内置在 app/config.py 的 DEFAULTS 中，此处无需重复配置。
# 如需覆盖，取消下行注释并填入新值：
TWINLOOP_COOKIE_SECURE=false

# ---- 前端跨域 ----
TWINLOOP_CORS_ORIGINS=http://127.0.0.1:3000

# 授权完成后浏览器跳回的前端地址
TWINLOOP_FRONTEND_URL=http://127.0.0.1:3000

DATABASE_URL=postgresql://xie:20260913@127.0.0.1:5432/zhihu
# Used only by Docker Compose; keep these consistent with DATABASE_URL.
POSTGRES_DB=zhihu
POSTGRES_USER=xie
POSTGRES_PASSWORD=20260913
POSTGRES_PORT=5432



MAX_AGENT_DIALOGUES=10
MAX_DIALOGUE_ROUNDS=10
GREAT_SCORE=0.8

DIALOGUE_OPINION_SIMILARITY_THRESHOLD=0.65
DIALOGUE_OPINION_CONFIDENCE_THRESHOLD=0.60
DIALOGUE_INTEREST_THRESHOLD=0.55


# Chroma 本地持久化配置
CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=E:/ZH/Zhihu/backend/data/chroma
CHROMA_MEMORY_COLLECTION=avatar_memories
CHROMA_SOURCE_COLLECTION=source_documents
CHROMA_CHAT_COLLECTION=chat_messages


CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=E:/ZH/Zhihu/backend/data/chroma

CHROMA_MEMORY_COLLECTION=avatar_memories
CHROMA_SOURCE_COLLECTION=source_documents
CHROMA_CHAT_COLLECTION=chat_messages
