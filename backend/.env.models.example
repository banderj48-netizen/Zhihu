# 独立的大模型环境模板；复制为 backend/.env.models 后填写真实密钥。
# backend/agent/runtime/model_config.py 会读取此文件，系统环境变量优先。

# 主 Agent（OpenAI 兼容 Chat Completions）
LLM_API_KEY=replace_with_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 评判 Agent；可与主 Agent 使用不同供应商或模型
EVALUATOR_LLM_API_KEY=replace_with_evaluator_api_key
EVALUATOR_LLM_BASE_URL=https://api.deepseek.com
EVALUATOR_LLM_MODEL=deepseek-chat

# 可选的 OpenAI 命名兼容项；仅在没有 LLM_* 时使用
# OPENAI_API_KEY=replace_with_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 阿里云百炼 Embedding（OpenAI 兼容接口）
EMBEDDING_API_KEY=replace_with_dashscope_api_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_BATCH_SIZE=10
