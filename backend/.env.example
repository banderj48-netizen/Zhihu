# Copy to backend/.env and replace placeholders for your own PostgreSQL.
# local_postgres.py init creates a separate random-password .env automatically.
DATABASE_URL=postgresql://twinloop:replace_with_strong_password@127.0.0.1:5432/twinloop
# Used only by Docker Compose; keep these consistent with DATABASE_URL.
POSTGRES_DB=twinloop
POSTGRES_USER=twinloop
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_PORT=5432

# 大模型配置请复制 backend/.env.models.example 为 backend/.env.models 后填写
# backend/.env 只保存数据库、OAuth 和应用运行参数，不保存模型密钥。
MAX_AGENT_DIALOGUES=10
MAX_DIALOGUE_ROUNDS=10
GREAT_SCORE=0.8
DIALOGUE_OPINION_SIMILARITY_THRESHOLD=0.65
DIALOGUE_OPINION_CONFIDENCE_THRESHOLD=0.60
DIALOGUE_INTEREST_THRESHOLD=0.55

# Chroma 本地持久化配置；也支持 CHROMA_MODE=http 连接独立 Chroma Server
CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=E:/ZH/Zhihu/backend/data/chroma
CHROMA_MEMORY_COLLECTION=avatar_memories
CHROMA_SOURCE_COLLECTION=source_documents
CHROMA_CHAT_COLLECTION=chat_messages
